[Unit]
Description=Give Hermes its OpenRouter key once this runner is granted it
# Not after cloud-final, which runs after multi-user.target: that would be an
# ordering cycle. cloud-init installs bh-secret and names the runner meanwhile, and
# hermes-gate keeps trying until it has.
After=nginx.service
Wants=nginx.service

[Service]
ExecStart=/usr/local/sbin/hermes-gate
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
