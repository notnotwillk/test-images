#!/bin/sh
# Runs inside the image once its packages are installed.
set -eu
# Fail the build, not the runner, if a page or the nginx configuration is broken.
python3 /usr/share/knowledge-base/render.py
nginx -t
systemctl enable systemd-networkd.service systemd-resolved.service nginx.service
# Each runner gets its own machine ID on first boot.
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id
